<?xml version="1.0"?>
<robot name="robot_arm_5dof">
  <material name="base_brown"><color rgba="0.45 0.22 0.08 1"/></material>
  <material name="servo_dark"><color rgba="0.16 0.16 0.18 1"/></material>
  <material name="link_blue"><color rgba="0.20 0.55 0.90 1"/></material>
  <material name="joint_gray"><color rgba="0.35 0.36 0.39 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.012"/><geometry><box size="0.12 0.12 0.024"/></geometry><material name="base_brown"/></visual>
    <collision><origin xyz="0 0 0.012"/><geometry><box size="0.12 0.12 0.024"/></geometry></collision>
  </link>

  <link name="base_servo">
    <visual><origin xyz="0 0 0.022"/><geometry><box size="0.041 0.030 0.044"/></geometry><material name="servo_dark"/></visual>
    <collision><origin xyz="0 0 0.022"/><geometry><box size="0.041 0.030 0.044"/></geometry></collision>
  </link>
  <joint name="base_mount" type="fixed"><parent link="base_link"/><child link="base_servo"/><origin xyz="0 0 0.024"/></joint>

  <link name="shoulder_servo">
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry><material name="joint_gray"/></visual>
    <collision><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry></collision>
  </link>
  <joint name="base_yaw" type="revolute"><parent link="base_servo"/><child link="shoulder_servo"/><origin xyz="0 0 0.044"/><axis xyz="0 0 1"/><limit lower="-1.5707963" upper="1.5707963" effort="5" velocity="1.5"/></joint>

  <link name="link1">
    <visual><origin xyz="0.055 0 0"/><geometry><box size="0.110 0.018 0.008"/></geometry><material name="link_blue"/></visual>
    <collision><origin xyz="0.055 0 0"/><geometry><box size="0.110 0.018 0.008"/></geometry></collision>
  </link>
  <joint name="shoulder_pitch" type="revolute"><parent link="shoulder_servo"/><child link="link1"/><origin xyz="0 0 0.028"/><axis xyz="0 1 0"/><limit lower="-1.3962634" upper="1.3962634" effort="2" velocity="1.2"/></joint>

  <link name="elbow_servo">
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry><material name="joint_gray"/></visual>
    <collision><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry></collision>
  </link>
  <joint name="elbow_mount" type="fixed"><parent link="link1"/><child link="elbow_servo"/><origin xyz="0.110 0 0.004"/></joint>

  <link name="link2">
    <visual><origin xyz="0.045 0 0"/><geometry><box size="0.090 0.018 0.008"/></geometry><material name="link_blue"/></visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.090 0.018 0.008"/></geometry></collision>
  </link>
  <joint name="elbow_pitch" type="revolute"><parent link="elbow_servo"/><child link="link2"/><origin xyz="0 0 0.028"/><axis xyz="0 1 0"/><limit lower="-1.5707963" upper="1.5707963" effort="2" velocity="1.2"/></joint>

  <link name="wrist_servo">
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry><material name="joint_gray"/></visual>
    <collision><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry></collision>
  </link>
  <joint name="wrist_pitch" type="revolute"><parent link="link2"/><child link="wrist_servo"/><origin xyz="0.090 0 0.004"/><axis xyz="0 1 0"/><limit lower="-1.3962634" upper="1.3962634" effort="1" velocity="1.2"/></joint>

  <link name="link3">
    <visual><origin xyz="0.0275 0 0"/><geometry><box size="0.055 0.014 0.006"/></geometry><material name="link_blue"/></visual>
    <collision><origin xyz="0.0275 0 0"/><geometry><box size="0.055 0.014 0.006"/></geometry></collision>
  </link>
  <joint name="link3_mount" type="fixed"><parent link="wrist_servo"/><child link="link3"/><origin xyz="0.012 0 0.028"/></joint>

  <link name="end_servo">
    <visual><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry><material name="joint_gray"/></visual>
    <collision><origin xyz="0 0 0.014"/><geometry><box size="0.030 0.024 0.028"/></geometry></collision>
  </link>
  <joint name="end_servo_mount" type="fixed"><parent link="link3"/><child link="end_servo"/><origin xyz="0.055 0 0.004"/></joint>

  <link name="tool_link">
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.014 0.006"/></geometry><material name="link_blue"/></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.014 0.006"/></geometry></collision>
  </link>
  <joint name="end_yaw" type="revolute"><parent link="end_servo"/><child link="tool_link"/><origin xyz="0 0 0.028"/><axis xyz="0 0 1"/><limit lower="-1.5707963" upper="1.5707963" effort="1" velocity="1.2"/></joint>

  <link name="tool_tip"/>
  <joint name="tool_tip_mount" type="fixed"><parent link="tool_link"/><child link="tool_tip"/><origin xyz="0.070 0 0"/></joint>
</robot>
