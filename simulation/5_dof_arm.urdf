<?xml version="1.0"?>
<robot name="robot_arm_5dof">
  <material name="brown"><color rgba="0.45 0.22 0.08 1"/></material>
  <material name="mg_dark"><color rgba="0.16 0.16 0.16 1"/></material>
  <material name="servo_gray"><color rgba="0.31 0.31 0.34 1"/></material>
  <material name="sky_blue"><color rgba="0.53 0.81 0.92 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/base.stl" scale="0.001 0.001 0.001"/></geometry><material name="brown"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.12 0.12 0.008"/></geometry></collision>
  </link>

  <link name="base_servo">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/mg996r.stl" scale="0.001 0.001 0.001"/></geometry><material name="mg_dark"/></visual>
    <collision><geometry><box size="0.0407 0.0197 0.0429"/></geometry></collision>
  </link>
  <joint name="base_mount" type="fixed"><parent link="base_link"/><child link="base_servo"/><origin xyz="0 0 0.02545"/></joint>

  <link name="shoulder_servo">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/sg90.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo_gray"/></visual>
    <collision><geometry><box size="0.023 0.0125 0.022"/></geometry></collision>
  </link>
  <joint name="base_yaw" type="revolute"><parent link="base_servo"/><child link="shoulder_servo"/><origin xyz="0 0 0.035"/><axis xyz="0 0 1"/><limit lower="-1.5707963" upper="1.5707963" effort="5" velocity="1.5"/></joint>

  <link name="link1">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/link1.stl" scale="0.001 0.001 0.001"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0.055 0 0"/><geometry><box size="0.11 0.018 0.004"/></geometry></collision>
  </link>
  <joint name="shoulder_pitch" type="revolute"><parent link="shoulder_servo"/><child link="link1"/><origin xyz="0 0 0.012"/><axis xyz="0 1 0"/><limit lower="-1.3962634" upper="1.3962634" effort="2" velocity="1.2"/></joint>

  <link name="elbow_servo">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/sg90.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo_gray"/></visual>
    <collision><geometry><box size="0.023 0.0125 0.022"/></geometry></collision>
  </link>
  <joint name="elbow_mount" type="fixed"><parent link="link1"/><child link="elbow_servo"/><origin xyz="0.110 0 0.004"/></joint>

  <link name="link2">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/link2.stl" scale="0.001 0.001 0.001"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.018 0.004"/></geometry></collision>
  </link>
  <joint name="elbow_pitch" type="revolute"><parent link="elbow_servo"/><child link="link2"/><origin xyz="0 0 0.011"/><axis xyz="0 1 0"/><limit lower="-1.5707963" upper="1.5707963" effort="2" velocity="1.2"/></joint>

  <link name="wrist_servo">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/sg90.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo_gray"/></visual>
    <collision><geometry><box size="0.023 0.0125 0.022"/></geometry></collision>
  </link>
  <joint name="wrist_pitch" type="revolute"><parent link="link2"/><child link="wrist_servo"/><origin xyz="0.090 0 0.004"/><axis xyz="0 1 0"/><limit lower="-1.3962634" upper="1.3962634" effort="1" velocity="1.2"/></joint>

  <link name="link3">
    <visual><origin xyz="0.0275 0 0"/><geometry><box size="0.055 0.014 0.004"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0.0275 0 0"/><geometry><box size="0.055 0.014 0.004"/></geometry></collision>
  </link>
  <joint name="link3_mount" type="fixed"><parent link="wrist_servo"/><child link="link3"/><origin xyz="0.012 0 0"/></joint>

  <link name="end_servo">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://4dofarm/meshes/sg90.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo_gray"/></visual>
    <collision><geometry><box size="0.023 0.0125 0.022"/></geometry></collision>
  </link>
  <joint name="end_servo_mount" type="fixed"><parent link="link3"/><child link="end_servo"/><origin xyz="0.055 0 0.004"/></joint>

  <link name="tool_link">
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.014 0.004"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0.035 0 0"/><geometry><box size="0.070 0.014 0.004"/></geometry></collision>
  </link>
  <joint name="end_yaw" type="revolute"><parent link="end_servo"/><child link="tool_link"/><origin xyz="0 0 0.012"/><axis xyz="0 0 1"/><limit lower="-1.5707963" upper="1.5707963" effort="1" velocity="1.2"/></joint>

  <link name="tool_tip"/>
  <joint name="tool_tip_mount" type="fixed"><parent link="tool_link"/><child link="tool_tip"/><origin xyz="0.070 0 0"/></joint>
</robot>
